@Task_Management_System_HostAddress = http://localhost:5149
@apiKey = Tas-Man-Sys-ApiKey-Vince-23-1762-524

### LOGIN AS ADMIN
POST {{Task_Management_System_HostAddress}}/api/auth/login
Content-Type: application/json
X-API-KEY: {{apiKey}}

{
  "username": "admin",
  "password": "admin123"
}

### LOGIN AS MANAGER
POST {{Task_Management_System_HostAddress}}/api/auth/login
Content-Type: application/json
X-API-KEY: {{apiKey}}

{
  "username": "manager",
  "password": "manager123"
}

### LOGIN AS EMPLOYEE
POST {{Task_Management_System_HostAddress}}/api/auth/login
Content-Type: application/json
X-API-KEY: {{apiKey}}

{
  "username": "employee",
  "password": "employee123"
}

### LOGIN WITHOUT API KEY - SHOULD FAIL
POST {{Task_Management_System_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

### LOGIN WITH WRONG API KEY - SHOULD FAIL
POST {{Task_Management_System_HostAddress}}/api/auth/login
Content-Type: application/json
X-API-KEY: wrong-key

{
  "username": "admin",
  "password": "admin123"
}

### GET TASKS - PASTE EMPLOYEE, MANAGER, OR ADMIN TOKEN
GET {{Task_Management_System_HostAddress}}/api/tasks
X-API-KEY: {{apiKey}}
Authorization: Bearer PASTE_TOKEN_HERE

### CREATE TASK - PASTE ADMIN OR MANAGER TOKEN
POST {{Task_Management_System_HostAddress}}/api/tasks
Content-Type: application/json
X-API-KEY: {{apiKey}}
Authorization: Bearer PASTE_TOKEN_HERE

{
  "title": "Finish Documentation",
  "description": "Complete the API documentation"
}

### UPDATE TASK - PASTE ADMIN OR MANAGER TOKEN
PUT {{Task_Management_System_HostAddress}}/api/tasks/1
Content-Type: application/json
X-API-KEY: {{apiKey}}
Authorization: Bearer PASTE_TOKEN_HERE

{
  "title": "Prepare Report Updated",
  "description": "Update and finalize weekly report",
  "status": "Completed"
}

### GET USERS - ADMIN ONLY
GET {{Task_Management_System_HostAddress}}/api/admin/users
X-API-KEY: {{apiKey}}
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

